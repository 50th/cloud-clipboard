# ============================================================
# 云剪贴板 · 生产 Compose 变量模板
# 使用：Copy-Item .env.example .env（在 deploy/ 目录下）
# ⚠️ Compose 只会自动读取 compose 文件同目录下的 .env 做变量插值；
#    后端自身的配置仍放在 server/.env（通过 env_file 注入）。
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=clipboard
# ⚠️ 必须修改；含特殊字符时需先做 URL 编码（会拼进 DATABASE_URL）
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clipboard

# --- Web ---
# 宿主机端口：80/443 被其他业务占用时改成 8080/8443
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# ⚠️ 构建期写入 bundle：改 IP / 域名 / 协议后必须重新 build web 镜像
# 无域名阶段用 IP + 自签证书（浏览器会提示不受信任）
VITE_API_BASE_URL=https://YOUR_SERVER_IP:8443

# --- HTTPS 证书 ---
# 放到 deploy/certs/，文件名固定为 fullchain.pem 与 privkey.pem。
# 自签证书生成示例（在服务器仓库根目录执行）：
#   mkdir -p deploy/certs
#   openssl req -x509 -nodes -newkey rsa:2048 -days 825 \
#     -keyout deploy/certs/privkey.pem \
#     -out deploy/certs/fullchain.pem \
#     -subj "/CN=YOUR_SERVER_IP" \
#     -addext "subjectAltName=IP:YOUR_SERVER_IP"
#   chmod 600 deploy/certs/privkey.pem
