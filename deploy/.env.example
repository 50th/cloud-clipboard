# ============================================================
# 云剪贴板 · 生产 Compose 变量模板
# 使用：Copy-Item .env.example .env（在 deploy/ 目录下）
# ⚠️ Compose 只会自动读取 compose 文件同目录下的 .env 做变量插值；
#    后端自身的配置仍放在 server/.env（通过 env_file 注入）。
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=clipboard
# ⚠️ 必须修改；含特殊字符时需先做 URL 编码（会拼进 DATABASE_URL）
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clipboard

# --- Web ---
# ⚠️ 构建期写入 bundle：改 IP / 域名 / 协议后必须重新 build web 镜像
# 无域名阶段填 http://<服务器IP>；启用 HTTPS 后填 https://<域名或IP>
VITE_API_BASE_URL=http://YOUR_SERVER_IP
