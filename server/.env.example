# ============================================================
# 云剪贴板后端环境变量模板
# 使用方式：copy .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，绝不要把真实密钥提交到仓库
# ============================================================

# --- 应用 ---
APP_NAME=Cloud Clipboard
APP_ENV=development

# ⚠️ 安全开关，默认全部关闭
# DEBUG：控制错误详情是否外露。生产必须 false。
# ENABLE_DEV_ROUTES：开发/测试辅助路由（/api/v1/dev/*）的总开关。
#   故意与 DEBUG 解耦：调试时可能临时开 DEBUG，但清库类接口不该跟着被打开。
#   /api/v1/dev/reset 会**删除数据**（重建种子数据），生产环境务必保持 false。
# 本地开发要跑 web 端的 pnpm test（会调用 dev/reset 恢复种子数据）时，设成 true。
DEBUG=false
ENABLE_DEV_ROUTES=false

API_V1_PREFIX=/api/v1

# --- 数据库 ---
# 本地容器：宿主 5433（5432 被本机原生 PostgreSQL 18 占用，见 infra/docker-compose.yml）
DATABASE_URL=postgresql+asyncpg://clipboard:clipboard@127.0.0.1:5433/clipboard
# 打开后会把每条 SQL 打到日志，排查问题时用
DB_ECHO=false

# --- 演示用户（第 4 步接入真实登录前，所有请求都归属该用户）---
DEMO_USER_ID=3f1a9c62-7d4b-4e18-9f2a-6b0c5d8e1a34
DEMO_USERNAME=demo
DEMO_EMAIL=demo@cloud-clipboard.dev

# --- CORS（JSON 数组，逗号分隔亦可）---
# Web 端开发服务器（Vite，端口 5273）+ 鸿蒙模拟器
# ⚠️ 端口不能写 5173：Windows 保留了 5141-5240 区间，Web 端已改用 5273
CORS_ORIGINS=["http://localhost:5273","http://127.0.0.1:5273","http://localhost:3000"]

# --- Redis（第 5 步启用）---
# REDIS_URL=redis://localhost:6379/0

# --- JWT（第 4 步启用，生产环境必须替换）---
# JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080

# --- 测试（第 8 步启用）---
# 后端 pytest 使用的独立测试库，避免误清开发库
# TEST_DATABASE_URL=postgresql+asyncpg://clipboard:clipboard@127.0.0.1:5433/clipboard_test
