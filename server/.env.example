# ============================================================
# 云剪贴板后端环境变量模板
# 使用方式：copy .env.example .env
# ⚠️ .env 已被 .gitignore 忽略，绝不要把真实密钥提交到仓库
# ============================================================

# --- 应用 ---
APP_NAME=Cloud Clipboard
APP_ENV=development

# ⚠️ 安全开关，默认全部关闭
# DEBUG：控制错误详情是否外露。生产必须 false。
# ENABLE_DEV_ROUTES：开发/测试辅助路由（/api/v1/dev/*）的总开关。
#   故意与 DEBUG 解耦：调试时可能临时开 DEBUG，但清库类接口不该跟着被打开。
#   第 3 步接入数据库后，该路由会变成"清库"，生产环境务必保持 false。
# 本地开发要跑 web 端的 pnpm test（会调用 dev/reset 恢复种子数据）时，设成 true。
DEBUG=false
ENABLE_DEV_ROUTES=false

API_V1_PREFIX=/api/v1

# --- CORS（JSON 数组，逗号分隔亦可）---
# Web 端开发服务器（Vite）+ 鸿蒙模拟器
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# --- 数据库（第 3 步启用）---
# DATABASE_URL=postgresql+asyncpg://clipboard:clipboard@localhost:5432/clipboard

# --- Redis（第 5 步启用）---
# REDIS_URL=redis://localhost:6379/0

# --- JWT（第 4 步启用，生产环境必须替换）---
# JWT_SECRET=change-me-in-production
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=10080
