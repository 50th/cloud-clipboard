# Web 端环境变量模板
# 使用方式：Copy-Item .env.example .env
# ⚠️ 只有 VITE_ 前缀的变量会被注入到前端代码

# 后端 API 地址
VITE_API_BASE_URL=http://127.0.0.1:8000

# WebSocket 地址（第 5 步启用）
VITE_WS_URL=ws://127.0.0.1:8000

# 认证令牌覆盖值。
# ⚠️ 一般留空：登录后令牌由前端写入 localStorage 并自动附加到请求头。
#    只有自动化测试需要预置令牌绕过登录界面时才用。
VITE_AUTH_TOKEN=

# 开发服务器端口由 vite.config.ts 决定（当前 5273）。
# 不要改回 5173：它落在 Windows 保留区间 5141-5240 内，会无法绑定。
