node_modules/
dist/
build/
coverage/
venv/
__pycache__/
*.py[cod]
# pytest / 覆盖率产物
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
# --- 环境变量（含密钥，绝不提交；仅保留模板）---
.env
.env.*
!.env.example
.vite/
*.tsbuildinfo
.DS_Store
docs/.openapi.json
# 后端运行日志（RotatingFileHandler 默认写入 server/logs/）
server/logs/

# --- 生产部署敏感文件（证书私钥绝不入库）---
deploy/certs/
*.pem
*.key
*.crt

# --- 数据库备份 ---
*.dump
*.sql
deploy/backups/

# --- 编辑器 ---
.vscode/

# --- 鸿蒙端（DevEco）---
# 构建缓存与日志：hvigor 会在每次构建时重写，不该入库
.hvigor/
# ArkTS 预览（Previewer）编译缓存，同样是每次构建重写
.preview/
# ohpm 安装的依赖
oh_modules/
# DevEco 的本地配置（含 SDK 路径、签名信息等机器相关配置）
.idea/
# 构建产物（build/ 已在上面统一忽略，这里再显式列出鸿蒙的路径便于阅读）
harmony/**/build/
# 签名材料：绝不入库
*.p12
*.p7b
*.cer
*.keystore
