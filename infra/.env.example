# 本地基础设施环境变量模板
# 使用方式：Copy-Item infra\.env.example infra\.env
# 该文件被 .gitignore 忽略，不要提交真实密码

# --- PostgreSQL 容器 ---
POSTGRES_USER=clipboard
POSTGRES_PASSWORD=clipboard
POSTGRES_DB=clipboard
# 宿主端口：5432 已被本机原生 PostgreSQL 18 占用，容器用 5433
POSTGRES_PORT=5433

# 对应的后端连接串（写进 server\.env 的 DATABASE_URL）
# ⚠️ 本地容器是 5433，别写成 5432（那是本机原生 PostgreSQL 18）
# DATABASE_URL=postgresql+asyncpg://clipboard:clipboard@127.0.0.1:5433/clipboard
